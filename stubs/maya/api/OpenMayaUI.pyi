import maya.api.OpenMaya as om2

class M3dView:
    def getCamera(self) -> om2.MDagPath: ...
    def isVisible(self) -> bool: ...
    def portWidth(self) -> int: ...
    def portHeight(self) -> int: ...
    def readColorBuffer(self, image: om2.MImage, readRGBA: bool = False) -> None: ...
    def refresh(self, all: bool = False, force: bool = False, offscreen: bool = False) -> None: ...
    def setCamera(self, camera: om2.MDagPath) -> None: ...
    def widget(self) -> int: ...
    @classmethod
    def active3dView(cls) -> M3dView: ...
    @classmethod
    def get3dView(cls, index: int) -> M3dView: ...
    @classmethod
    def getM3dViewFromModelPanel(cls, modenPaneName: str) -> M3dView: ...
    @classmethod
    def numberOf3dViews(cls) -> int: ...
