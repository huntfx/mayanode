import typing

import maya.api.OpenMaya as om2

class MFnAnimCurve:
    numKeys: int
    @typing.overload
    def __init__(self, object: om2.MObject) -> None: ...
    @typing.overload
    def __init__(self, pluf: om2.MPlug) -> None: ...
    def input(self, index: int) -> om2.MTime: ...
    def value(self, index: int) -> float: ...


class MAnimUtil:
    @typing.overload
    @classmethod
    def isAnimated(cls, node: om2.MObject, checkParent: bool = False) -> bool: ...
    @typing.overload
    @classmethod
    def isAnimated(cls, path: om2.MDagPath, checkParent: bool = False) -> bool: ...
    @typing.overload
    @classmethod
    def isAnimated(cls, plug: om2.MPlug, checkParent: bool = False) -> bool: ...
    @typing.overload
    @classmethod
    def isAnimated(cls, selectionList: om2.MSelectionList, checkParent: bool = False) -> bool: ...
    @typing.overload
    @classmethod
    def findAnimatedPlugs(cls, node: om2.MObject, checkParent: bool = False) -> om2.MPlugArray: ...
    @typing.overload
    @classmethod
    def findAnimatedPlugs(cls, path: om2.MDagPath, checkParent: bool = False) -> om2.MPlugArray: ...
    @typing.overload
    @classmethod
    def findAnimatedPlugs(cls, selectionList: om2.MSelectionList, checkParent: bool = False) -> om2.MPlugArray: ...
    @classmethod
    def findAnimation(cls, plug: om2.MPlug) -> om2.MObjectArray: ...
